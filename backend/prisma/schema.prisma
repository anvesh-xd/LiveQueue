generator client {
  provider    = "prisma-client-js"
  engineType  = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  pending
  accepted
  declined
  played
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requests      Request[]
  refreshTokens RefreshToken[]
}

model DJ {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  venues        VenueDJ[]
  requests      Request[]
  refreshTokens RefreshToken[]
  inviteCode    InviteCode?
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  djs       VenueDJ[]
  requests  Request[]
}

model VenueDJ {
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId String
  dj      DJ     @relation(fields: [djId], references: [id], onDelete: Cascade)
  djId    String

  @@id([venueId, djId])
  @@index([djId])
  @@index([venueId])
}

model Request {
  id             String        @id @default(cuid())
  userId         String
  djId           String
  venueId        String

  deezerTrackId  String
  songTitle      String
  artistName     String
  albumArtUrl    String?

  status         RequestStatus @default(pending)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  playedAt       DateTime?

  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dj             DJ    @relation(fields: [djId], references: [id], onDelete: Cascade)
  venue          Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([djId])
  @@index([venueId])
  @@index([status])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  djId      String?
  type      String   // 'patron' or 'dj'
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  dj   DJ?   @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([djId])
  @@index([expiresAt])
}

model InviteCode {
  id         String   @id @default(cuid())
  code       String   @unique
  used       Boolean  @default(false)
  usedByDjId String?  @unique
  label      String?
  createdAt  DateTime @default(now())

  usedByDj   DJ?      @relation(fields: [usedByDjId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([used])
}
